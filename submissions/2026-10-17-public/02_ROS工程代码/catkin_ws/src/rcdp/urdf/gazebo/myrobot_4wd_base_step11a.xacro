<?xml version="1.0"?>
<!--
  Stage 11A: four-wheel physical base for the user's selected 4WD skid-steer.
  Retains the proven step-4 body, mast, platform and sensor geometry.
  Replaces two drive wheels plus two spherical supports with four equal wheels.
  The controller and live sensors are deliberately not loaded at this stage.
  Masses below are teaching-model assumptions, not measured robot masses.
  This stage has no drive or sensor plugins.
-->
<robot name="lesson13_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="Pi" value="3.141592653589793"/>
  <xacro:property name="base_radius" value="0.4"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="move_wheel_radius" value="0.1"/>
  <xacro:property name="move_wheel_height" value="0.08"/>
  <!-- Initial teaching-model dimensions: front/rear spacing and left/right spacing. -->
  <xacro:property name="wheelbase" value="0.4"/>
  <xacro:property name="track_width" value="0.72"/>
  <xacro:property name="support_radius" value="0.1"/>
  <xacro:property name="support_height" value="0.4"/>
  <xacro:property name="platform_radius" value="0.25"/>
  <xacro:property name="platform_height" value="0.15"/>
  <xacro:property name="laser_length" value="0.05"/>
  <xacro:property name="laser_width" value="0.06"/>
  <xacro:property name="laser_height" value="0.08"/>
  <xacro:property name="depth_length" value="0.05"/>
  <xacro:property name="depth_width" value="0.08"/>
  <xacro:property name="depth_height" value="0.08"/>

  <!-- Cylinder symmetry axis is the link's Z axis. -->
  <xacro:macro name="cylinder_z_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*(3*r*r+h*h)/12.0}" iyz="0" izz="${m*r*r/2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Wheel cylinder symmetry axis is Y, matching its collision and joint. -->
  <xacro:macro name="wheel_y_inertia" params="m r h">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" ixy="0" ixz="0"
               iyy="${m*r*r/2.0}" iyz="0" izz="${m*(3*r*r+h*h)/12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- Box dimensions are x along X, y along Y, z along Z. -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" ixy="0" ixz="0"
               iyy="${m*(x*x+z*z)/12.0}" iyz="0" izz="${m*(x*x+y*y)/12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_body" params="name r h m rgba gz_material">
    <link name="${name}">
      <visual>
        <geometry><cylinder radius="${r}" length="${h}"/></geometry>
        <material name="${name}_color"><color rgba="${rgba}"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${r}" length="${h}"/></geometry>
      </collision>
      <xacro:cylinder_z_inertia m="${m}" r="${r}" h="${h}"/>
    </link>
    <gazebo reference="${name}"><material>${gz_material}</material></gazebo>
  </xacro:macro>

  <xacro:macro name="box_body" params="name x y z m rgba gz_material">
    <link name="${name}">
      <visual>
        <geometry><box size="${x} ${y} ${z}"/></geometry>
        <material name="${name}_color"><color rgba="${rgba}"/></material>
      </visual>
      <collision><geometry><box size="${x} ${y} ${z}"/></geometry></collision>
      <xacro:box_inertia m="${m}" x="${x}" y="${y}" z="${z}"/>
    </link>
    <gazebo reference="${name}"><material>${gz_material}</material></gazebo>
  </xacro:macro>

  <xacro:macro name="contact_parameters" params="name mu">
    <gazebo reference="${name}">
      <mu1>${mu}</mu1><mu2>${mu}</mu2>
      <kp>100000</kp><kd>10</kd>
      <minDepth>0.001</minDepth><maxVel>0.1</maxVel>
    </gazebo>
  </xacro:macro>

  <!-- Massless reference only: no tiny physical body or inertia at the root. -->
  <link name="root_link"/>

  <xacro:cylinder_body name="base_link" r="${base_radius}" h="${base_height}"
                       m="5.0" rgba="1 0.843 0 1" gz_material="Gazebo/Yellow"/>
  <xacro:cylinder_body name="support_link" r="${support_radius}" h="${support_height}"
                       m="0.3" rgba="0.118 0.565 1 1" gz_material="Gazebo/Blue"/>
  <xacro:cylinder_body name="platform_link" r="${platform_radius}" h="${platform_height}"
                       m="1.0" rgba="0 1 0.498 1" gz_material="Gazebo/Green"/>

  <joint name="base_link2root_link" type="fixed">
    <parent link="root_link"/><child link="base_link"/>
    <origin xyz="0 0 ${base_height/2.0+move_wheel_radius}" rpy="0 0 0"/>
  </joint>
  <joint name="support_link2base_link" type="fixed">
    <parent link="base_link"/><child link="support_link"/>
    <origin xyz="0 0 ${base_height/2.0+support_height/2.0}" rpy="0 0 0"/>
  </joint>
  <joint name="platform_link2support_link" type="fixed">
    <parent link="support_link"/><child link="platform_link"/>
    <origin xyz="0 0 ${support_height/2.0+platform_height/2.0}" rpy="0 0 0"/>
  </joint>

  <!-- X forward, Y left, Z up; all four joint axes point along +Y.
       Positive wheel speed will have the same forward convention on both sides. -->
  <xacro:macro name="drive_wheel" params="wheel_name x_sign y_sign">
    <link name="${wheel_name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${Pi/2.0} 0 0"/>
        <geometry><cylinder radius="${move_wheel_radius}" length="${move_wheel_height}"/></geometry>
        <material name="${wheel_name}_wheel_color"><color rgba="0.3 0.3 0.3 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${Pi/2.0} 0 0"/>
        <geometry><cylinder radius="${move_wheel_radius}" length="${move_wheel_height}"/></geometry>
      </collision>
      <xacro:wheel_y_inertia m="0.3" r="${move_wheel_radius}" h="${move_wheel_height}"/>
    </link>
    <joint name="${wheel_name}_wheel_joint" type="continuous">
      <parent link="base_link"/><child link="${wheel_name}_wheel_link"/>
      <origin xyz="${x_sign*wheelbase/2.0} ${y_sign*track_width/2.0} ${-base_height/2.0}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="10" velocity="10"/>
      <dynamics damping="0.02" friction="0"/>
    </joint>
    <gazebo reference="${wheel_name}_wheel_link"><material>Gazebo/Grey</material></gazebo>
    <xacro:contact_parameters name="${wheel_name}_wheel_link" mu="0.8"/>
  </xacro:macro>
  <xacro:drive_wheel wheel_name="front_left" x_sign="1" y_sign="1"/>
  <xacro:drive_wheel wheel_name="front_right" x_sign="1" y_sign="-1"/>
  <xacro:drive_wheel wheel_name="rear_left" x_sign="-1" y_sign="1"/>
  <xacro:drive_wheel wheel_name="rear_right" x_sign="-1" y_sign="-1"/>

  <xacro:box_body name="laser_scan_link" x="${laser_length}" y="${laser_width}" z="${laser_height}"
                  m="0.1" rgba="0.804 0.361 0.361 1" gz_material="Gazebo/Red"/>
  <xacro:box_body name="depth_camera_link" x="${depth_length}" y="${depth_width}" z="${depth_height}"
                  m="0.1" rgba="0.981 0.502 0.447 1" gz_material="Gazebo/Orange"/>

  <joint name="laser_scan_link2platform_link" type="continuous">
    <parent link="platform_link"/><child link="laser_scan_link"/>
    <origin xyz="${0.8*platform_radius} 0 ${platform_height/2.0+laser_height/2.0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1" velocity="5"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>
  <joint name="depth_camera_link2base_link" type="revolute">
    <parent link="base_link"/><child link="depth_camera_link"/>
    <origin xyz="${0.8*base_radius} 0 ${base_height/2.0+depth_height/2.0}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <!-- The slide requires +/-180 degrees; the original code used +/-1.57. -->
    <limit lower="${-Pi}" upper="${Pi}" effort="10" velocity="3"/>
    <dynamics damping="0.05" friction="0"/>
  </joint>

  <gazebo><static>false</static></gazebo>
</robot>
