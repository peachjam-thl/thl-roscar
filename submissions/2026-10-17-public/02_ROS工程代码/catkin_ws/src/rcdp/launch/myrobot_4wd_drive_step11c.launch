<?xml version="1.0"?>
<!-- Use only after precheck and a normal shutdown of the previous Gazebo launch.
     Do NOT launch concurrently with step11A, step9, step10 or another Gazebo. -->
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="true"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find rcdp)/urdf/gazebo/myrobot_4wd_drive_step11c.xacro'"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rcdp)/worlds/lesson14_box_house_step7.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_four_wheel_drive_step11c"
        args="-urdf -param robot_description -model lesson13_robot -x 0 -y 0 -z 0.02"
        output="screen"/>
</launch>
