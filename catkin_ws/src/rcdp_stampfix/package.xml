<?xml version="1.0"?>
<package format="2">
  <name>rcdp_stampfix</name>
  <version>0.1.0</version>
  <description>
    Isolated Gazebo 11 diff-drive timestamp patch based on gazebo_plugins 2.9.3.
    Uses Gazebo simulation timestamps for odometry, odometry TF and wheel states.
  </description>
  <maintainer email="thl@todo.todo">thl</maintainer>
  <license>BSD-3-Clause</license>
  <url type="repository">https://github.com/ros-simulation/gazebo_ros_pkgs</url>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>boost</depend>
  <depend>gazebo_dev</depend>
  <depend>gazebo_plugins</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <export>
    <gazebo_ros plugin_path="${prefix}/../../lib" />
  </export>
</package>
