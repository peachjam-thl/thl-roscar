<?xml version="1.0"?>
<package format="2">
  <name>rcdp_4wd_stampfix</name>
  <version>0.1.0</version>
  <description>Isolated four-wheel skid-steer Gazebo 11 controller with direct simulation-time odometry stamps.</description>
  <maintainer email="thl@todo.todo">thl</maintainer>
  <license>BSD-3-Clause</license>
  <url type="website">https://github.com/ros-simulation/gazebo_ros_pkgs/tree/2.9.3</url>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>boost</depend>
  <depend>gazebo_dev</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>tf</depend>
  <exec_depend>gazebo_ros</exec_depend>
  <export><gazebo_ros plugin_path="${prefix}/../../lib" /></export>
</package>
