<robot name="myrobot_urdf">

    <link name="root_link">
        <visual>
            <geometry>
                <cylinder radius="0.0001" length="0.0001" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Snow">
                <color rgba="1 0.98 0.98 0.8" />
            </material>
        </visual>
    </link>


    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="0.4" length="0.2" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Gold">
                <color rgba="1 0.843 0 0.8" />
            </material>
        </visual>
    </link>


    <link name="front_support_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="back_support_wheel_link">
        <visual>
            <geometry>
                <sphere radius="0.05" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.08" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.08" />
            </geometry>
            <origin xyz="0 0 0" rpy="1.57 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="support_link">
        <visual>
            <geometry>
                <cylinder radius="0.1" length="0.4" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="DodgerBlue">
                <color rgba="0.118 0.565 1 0.8" />
            </material>
        </visual>
    </link>


    <link name="platform_link">
        <visual>
            <geometry>
                <cylinder radius="0.25" length="0.15" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="SpringGreen">
                <color rgba="0 1 0.498 0.8" />
            </material>
        </visual>
    </link>


    <link name="laser_scan_link">
        <visual>
            <geometry>
                <box size="0.05 0.06 0.08" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="IndianRed">
                <color rgba="0.804 0.361 0.361 0.8" />
            </material>
        </visual>
    </link>


    <link name="depth_camera_link">
        <visual>
            <geometry>
                <box size="0.05 0.08 0.08" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Salmon">
                <color rgba="0.981 0.502 0.447 0.8" />
            </material>
        </visual>
    </link>


    <joint name="base_link2root_link" type="fixed">
        <parent link="root_link"/>
        <child link="base_link" />
        <origin xyz="0 0 0.2" rpy="0 0 0" />
        <axis xyz="0 0 0" />
    </joint>


    <joint name="front_support_wheel_link2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="front_support_wheel_link" />
        <origin xyz="0.32 0 -0.15" rpy="0 0 0" />
        <axis xyz="1 1 1" />
    </joint>


    <joint name="back_support_wheel_link2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="back_support_wheel_link" />
        <origin xyz="-0.32 0 -0.15" rpy="0 0 0" />
        <axis xyz="1 1 1" />
    </joint>


    <joint name="base_l_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link" />
        <origin xyz="0 0.4 -0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>


    <joint name="base_r_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link" />
        <origin xyz="0 -0.4 -0.1" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>


    <joint name="support_link2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="support_link" />
        <origin xyz="0 0 0.3" rpy="0 0 0" />
        <axis xyz="0 0 0" />
    </joint>


    <joint name="platform_link2support_link" type="fixed">
        <parent link="support_link"/>
        <child link="platform_link" />
        <origin xyz="0 0 0.275" rpy="0 0 0" />
        <axis xyz="0 0 0" />
    </joint>


    <joint name="depth_camera_link2base_link" type="revolute">
        <parent link="base_link"/>
        <child link="depth_camera_link" />
        <origin xyz="0.32 0 0.14" rpy="0 0 0" />
        <limit lower="-1.57" upper="1.57" effort="10" velocity="3"/>
        <axis xyz="0 0 1" />
    </joint>


    <joint name="laser_scan_link2platform_link" type="continuous">
        <parent link="platform_link"/>
        <child link="laser_scan_link" />
        <origin xyz="0.2 0 0.115" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>

</robot>