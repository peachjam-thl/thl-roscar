<?xml version="1.0"?>
<!-- Step 11H: measured joint positions and link TF only.
     Reuse the accepted four-wheel geometry and drive without modifications.
     The skid-steer drive does NOT publish joint states. This one plugin
     therefore measures ALL SIX moving joints, not the old support-wheel list.
     No live lidar/camera plugins or optical-frame links are added here. -->
<robot name="lesson13_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="myrobot_4wd_drive_step11c.xacro"/>

  <gazebo>
    <plugin name="lesson14_four_wheel_joint_states"
            filename="libgazebo_ros_joint_state_publisher.so">
      <robotNamespace>/</robotNamespace>
      <updateRate>50</updateRate>
      <jointName>front_left_wheel_joint,front_right_wheel_joint,rear_left_wheel_joint,rear_right_wheel_joint,depth_camera_link2base_link,laser_scan_link2platform_link</jointName>
    </plugin>
  </gazebo>
</robot>
