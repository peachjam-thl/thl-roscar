<robot name="myrobot_xacro" xmlns:xacro="http://www.ros.org/wiki/xacro">
    
    <xacro:property name="Pi" value="3.1415926535898" />
    
    <xacro:property name="root_radius" value="0.0001" />
    <xacro:property name="root_height" value="0.0001" />

    <xacro:property name="base_radius" value="0.4" />
    <xacro:property name="base_height" value="0.2" />

    <xacro:property name="move_wheel_radius" value="0.1" />
    <xacro:property name="move_wheel_height" value="0.08" />

    <xacro:property name="support_wheel_radius" value="0.05" />

    <xacro:property name="support_radius" value="0.1" />
    <xacro:property name="support_height" value="0.4" />

    <xacro:property name="platform_radius" value="0.25" />
    <xacro:property name="platform_height" value="0.15" />

    <xacro:property name="laser_length" value="0.05" />
    <xacro:property name="laser_width" value="0.06" />
    <xacro:property name="laser_height" value="0.08" />

    <xacro:property name="depth_length" value="0.05" />
    <xacro:property name="depth_width" value="0.08" />
    <xacro:property name="depth_height" value="0.08" />


    <link name="root_link">
        <visual>
            <geometry>
                <cylinder radius="${root_radius}" length="${root_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Snow">
                <color rgba="1 0.98 0.98 0.8" />
            </material>
        </visual>
    </link>


    <link name="base_link">
        <visual>
            <geometry>
                <cylinder radius="${base_radius}" length="${base_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Gold">
                <color rgba="1 0.843 0 0.8" />
            </material>
        </visual>
    </link>


    <link name="front_support_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${support_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="back_support_wheel_link">
        <visual>
            <geometry>
                <sphere radius="${support_wheel_radius}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${move_wheel_radius}" length="${move_wheel_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${Pi / 2} 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="right_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${move_wheel_radius}" length="${move_wheel_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="${Pi / 2} 0 0" />
            <material name="Voilet">
                <color rgba="0.933 0.51 0.933 0.8" />
            </material>
        </visual>
    </link>


    <link name="support_link">
        <visual>
            <geometry>
                <cylinder radius="${support_radius}" length="${support_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="DodgerBlue">
                <color rgba="0.118 0.565 1 0.8" />
            </material>
        </visual>
    </link>


    <link name="platform_link">
        <visual>
            <geometry>
                <cylinder radius="${platform_radius}" length="${platform_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="SpringGreen">
                <color rgba="0 1 0.498 0.8" />
            </material>
        </visual>
    </link>


    <link name="laser_scan_link">
        <visual>
            <geometry>
                <box size="${laser_length} ${laser_width} ${laser_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="IndianRed">
                <color rgba="0.804 0.361 0.361 0.8" />
            </material>
        </visual>
    </link>


    <link name="depth_camera_link">
        <visual>
            <geometry>
                <box size="${depth_length} ${depth_width} ${depth_height}" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="Salmon">
                <color rgba="0.981 0.502 0.447 0.8" />
            </material>
        </visual>
    </link>


    <joint name="base_link2root_link" type="fixed">
        <parent link="root_link"/>
        <child link="base_link" />
        <origin xyz="0 0 ${base_height / 2 + support_wheel_radius * 2 }" rpy="0 0 0" />
        <axis xyz="0 0 0" />
    </joint>


    <joint name="front_support_wheel_link2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="front_support_wheel_link" />
        <origin xyz="${0.8 * base_radius} 0 ${-(base_height / 2 + support_wheel_radius)}" rpy="0 0 0" />
        <axis xyz="1 1 1" />
    </joint>


    <joint name="back_support_wheel_link2base_link" type="continuous">
        <parent link="base_link"/>
        <child link="back_support_wheel_link" />
        <origin xyz="${-0.8 * base_radius} 0 ${-(base_height / 2 + support_wheel_radius)}" rpy="0 0 0" />
        <axis xyz="1 1 1" />
    </joint>


    <joint name="base_l_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link" />
        <origin xyz="0 ${base_radius} ${-base_height / 2}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>


    <joint name="base_r_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link" />
        <origin xyz="0 ${-base_radius} ${-base_height / 2}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>


    <joint name="support_link2base_link" type="fixed">
        <parent link="base_link"/>
        <child link="support_link" />
        <origin xyz="0 0 ${base_height / 2 + support_height / 2}" rpy="0 0 0" />
        <axis xyz="0 0 0" />
    </joint>


    <joint name="platform_link2support_link" type="fixed">
        <parent link="support_link"/>
        <child link="platform_link" />
        <origin xyz="0 0 ${support_height / 2 + platform_height / 2} " rpy="0 0 0" />
        <axis xyz="0 0 0" />
    </joint>


    <joint name="depth_camera_link2base_link" type="revolute">
        <parent link="base_link"/>
        <child link="depth_camera_link" />
        <origin xyz="${ 0.8 * base_radius} 0 ${base_height / 2 + depth_height / 2}" rpy="0 0 0" />
        <limit lower="-1.57" upper="1.57" effort="10" velocity="3" />
        <axis xyz="0 0 1" />
    </joint>


    <joint name="laser_scan_link2platform_link" type="continuous">
        <parent link="platform_link"/>
        <child link="laser_scan_link" />
        <origin xyz="${0.8 * platform_radius} 0 ${platform_height / 2 + laser_height / 2}" rpy="0 0 0" />
        <axis xyz="0 0 1" />
    </joint>


</robot>