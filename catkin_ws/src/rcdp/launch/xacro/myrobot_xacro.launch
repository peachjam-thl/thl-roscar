<launch>

    <param name="robot_description" command="$(find xacro)/xacro $(find rcdp)/urdf/xacro/myrobot_v2.xacro" />

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find rcdp)/config/myrobot.rviz" />

    <node pkg="joint_state_publisher" type="joint_state_publisher" name="joint_state_publisher" />
    
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" />

</launch>