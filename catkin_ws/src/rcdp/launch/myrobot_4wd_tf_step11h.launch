<?xml version="1.0"?>
<!-- New launch only; do not run alongside the existing Gazebo launch.
     Continue the tested B/cone world. No wheel/drive/physics tuning here. -->
<launch>
  <arg name="friction_model" default="cone_model"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="true"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find rcdp)/urdf/gazebo/myrobot_4wd_tf_step11h.xacro'"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rcdp)/worlds/lesson14_4wd_$(arg friction_model)_step11f.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_four_wheel_tf_step11h"
        args="-urdf -param robot_description -model lesson13_robot -x 0 -y 0 -z 0.02"
        output="screen"/>

  <!-- Measured /joint_states -> robot-relative TF, not odom -> root_link.
       Do NOT add a joint_state_publisher or a second root TF broadcaster. -->
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="lesson14_4wd_robot_state_publisher" output="screen">
    <param name="publish_frequency" value="50.0"/>
    <param name="listener_queue_size" value="100"/>
    <param name="use_tf_static" value="true"/>
  </node>
</launch>
