<?xml version="1.0"?>
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="true"/>
  <!-- Keep RViz separate during the first plugin acceptance test. -->
  <arg name="start_rviz" default="false"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find rcdp)/urdf/gazebo/myrobot_stampfix_step10.xacro'"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rcdp)/worlds/lesson14_box_house_step7.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_lesson13_robot"
        args="-urdf -param robot_description -model lesson13_robot -x 0 -y 0 -z 0.02"
        output="screen"/>

  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="lesson14_robot_state_publisher" output="screen">
    <param name="publish_frequency" value="50.0"/>
    <param name="listener_queue_size" value="100"/>
    <param name="use_tf_static" value="true"/>
  </node>

  <!-- Optional only. The first acceptance run leaves start_rviz=false. -->
  <group if="$(arg start_rviz)">
    <node pkg="rviz" type="rviz" name="lesson14_rviz_preview"
          args="-d $(find rcdp)/config/lesson14_cloud_preview_step9a.rviz" output="screen">
      <env name="LIBGL_ALWAYS_SOFTWARE" value="true"/>
    </node>
  </group>
</launch>
