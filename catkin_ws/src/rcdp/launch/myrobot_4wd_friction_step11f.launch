<?xml version="1.0"?>
<!-- A/B environment only. Do not run alongside another Gazebo launch.
     Valid friction_model arguments: pyramid_model (control), cone_model (trial).
     The robot and its compiled drive are exactly the existing step11C setup. -->
<launch>
  <arg name="friction_model" default="pyramid_model"/>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="verbose" default="true"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find rcdp)/urdf/gazebo/myrobot_4wd_drive_step11c.xacro'"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find rcdp)/worlds/lesson14_4wd_$(arg friction_model)_step11f.world"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="verbose" value="$(arg verbose)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <node pkg="gazebo_ros" type="spawn_model" name="spawn_four_wheel_friction_step11f"
        args="-urdf -param robot_description -model lesson13_robot -x 0 -y 0 -z 0.02"
        output="screen"/>
</launch>
