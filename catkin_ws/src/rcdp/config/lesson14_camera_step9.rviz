Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /RGB_Image1
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 0.5
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 1
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Visual Enabled: true
      Collision Enabled: false
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
        Link Tree Style: Links in Alphabetic Order
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Value: true
      Topic: /scan
      Queue Size: 20
      Unreliable: false
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 255; 70; 70
      Style: Flat Squares
      Size (Pixels): 3
      Size (m): 0.04
      Decay Time: 0
      Use Fixed Frame: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Value: true
      Frame Timeout: 15
      Marker Scale: 0.2
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Frames:
        All Enabled: true
    - Class: rviz/Image
      Name: RGB_Image
      Enabled: true
      Value: true
      Image Topic: /kinect/rgb/image_raw
      Transport Hint: raw
      Queue Size: 2
      Unreliable: false
      Normalize Range: true
    - Class: rviz/Image
      Name: Depth_Image
      Enabled: false
      Value: false
      Image Topic: /kinect/depth/image_raw
      Transport Hint: raw
      Queue Size: 2
      Unreliable: false
      Normalize Range: true
    - Class: rviz/PointCloud2
      Name: Depth_Points
      Enabled: false
      Value: false
      Topic: /kinect/depth/points
      Queue Size: 2
      Unreliable: false
      Alpha: 1
      Position Transformer: XYZ
      Color Transformer: RGB8
      Style: Points
      Size (Pixels): 2
      Size (m): 0.01
      Decay Time: 0
      Use Fixed Frame: true
      Selectable: true
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 40
    Default Light: true
    Frame Rate: 20
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 15
      Focal Point:
        X: -1.8
        Y: 0
        Z: 0.4
      Pitch: 0.8
      Yaw: 0.8
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Name: Current View
    Saved: []
Window Geometry:
  Width: 1100
  Height: 760
  Hide Left Dock: false
  Hide Right Dock: false
